# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NUNCA commite arquivos .env com valores reais!)
.env
.env.local
.env.development
.env.production
.env.*.local
deploy/.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
docs/CREDENCIAIS_DEMO.md

# artefatos de deploy (podem conter .env reais)
deploy.tar.gz
*.tar.gz
deploy/.env*

# uploads de usuários
/storage/
/public/uploads/*
!/public/uploads/comprovantes/
/public/uploads/comprovantes/*
!/public/uploads/comprovantes/.gitkeep

# configurações locais do Claude Code
.claude/settings.local.json

# worker do MapLibre copiado de node_modules (scripts/copiar-worker-mapa.mjs)
/public/vendor/maplibre/

# backups do banco e dos arquivos gerados no servidor (scripts/backup.sh)
/backups/

# arquivos locais do editor/agente e pacote duplicado do kit
*.swp
.claude/settings.local.json
scripts/kit-vendas/.src-pacote.zip
.env*
!.env*.example

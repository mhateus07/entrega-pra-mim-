generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
// Papel na plataforma. Só SUPERADMIN (equipe Impulsio) tem efeito de acesso;
// CLIENTE/MOTOBOY indicam o tipo de conta criada. O acesso aos dados vem do
// papel na organização (OrganizationMember.papel).
enum UserRole {
  SUPERADMIN
  CLIENTE
  MOTOBOY
}

// Papel do usuário dentro de uma central (organização)
enum OrgRole {
  OWNER
  DISPATCHER
  CLIENT
  DRIVER
}

enum StatusOrganizacao {
  PENDENTE
  ATIVA
  SUSPENSA
}

enum PlanoOrganizacao {
  ESSENCIAL
  CENTRAL
  MARCA_PROPRIA
}

enum StatusMotoboy {
  DISPONIVEL
  EM_ENTREGA
  OFFLINE
}

// Cadastro de motoboy só recebe pedidos depois de aprovado por um admin
enum AprovacaoMotoboy {
  PENDENTE_APROVACAO
  APROVADO
  REPROVADO
  SUSPENSO
}

enum TipoServico {
  EXPRESSA
  AGENDADA
  DOCUMENTOS
}

enum StatusPedido {
  SOLICITADO
  ACEITO
  EM_COLETA
  EM_ENTREGA
  ENTREGUE
  CANCELADO
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

enum MetodoPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
}

enum StatusPagamento {
  PENDENTE
  PROCESSANDO
  APROVADO
  RECUSADO
  CANCELADO
  REEMBOLSADO
}

// Modelos

// Central de motofrete: cada uma vê e opera apenas os próprios dados
model Organization {
  id        String            @id @default(cuid())
  nome      String
  slug      String            @unique
  plano     PlanoOrganizacao  @default(ESSENCIAL)
  status    StatusOrganizacao @default(PENDENTE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  settings   OrganizationSettings?
  membros    OrganizationMember[]
  motoboys   Motoboy[]
  clientes   Cliente[]
  enderecos  Endereco[]
  pedidos    Pedido[]
  pagamentos Pagamento[]
  avaliacoes Avaliacao[]
  mensagens  Mensagem[]
  saldos     SaldoMotoboy[]
  transacoes TransacaoMotoboy[]
  auditLogs  AuditLog[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  papel          OrgRole
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  // Marca (white-label, plano MARCA_PROPRIA)
  nomeExibicao   String?
  logoArquivo    String?
  corPrimaria    String?  @db.VarChar(7)
  // Taxa opcional da plataforma sobre a corrida (padrão 0: sem comissão)
  taxaPlataforma Decimal  @default(0) @db.Decimal(5, 4)
  // Fração do valor da corrida repassada ao motoboy no fechamento (só relatório)
  repasseMotoboy Decimal  @default(0.7) @db.Decimal(5, 4)
  fusoHorario    String   @default("America/Sao_Paulo")
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  senha         String
  nome          String
  telefone      String?
  role          UserRole  @default(CLIENTE)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Um perfil de motoboy/cliente por organização
  motoboys    Motoboy[]
  clientes    Cliente[]
  memberships OrganizationMember[]
  accounts    Account[]
  sessions    Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Motoboy {
  id              String           @id @default(cuid())
  organizationId  String
  userId          String
  cnh             String
  veiculoTipo     String // Moto, Bicicleta, etc
  veiculoMarca    String
  veiculoModelo   String
  veiculoPlaca    String
  status          StatusMotoboy    @default(OFFLINE)
  aprovacao       AprovacaoMotoboy @default(PENDENTE_APROVACAO)
  aprovacaoEm     DateTime?
  motivoAprovacao String?
  latitudeAtual   Float?
  longitudeAtual  Float?
  avaliacaoMedia  Float            @default(5.0)
  totalEntregas   Int              @default(0)
  ultimaAtividade DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  disponibilidades Disponibilidade[]
  pedidos          Pedido[]
  avaliacoes       Avaliacao[]
  saldo            SaldoMotoboy?
  transacoes       TransacaoMotoboy[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, userId])
  @@unique([organizationId, cnh])
  @@unique([organizationId, veiculoPlaca])
  @@index([userId])
  @@index([organizationId, status, createdAt, id])
  @@index([organizationId, aprovacao, createdAt, id])
  @@index([status, createdAt, id])
  @@index([aprovacao, createdAt, id])
  @@map("motoboys")
}

model Disponibilidade {
  id         String    @id @default(cuid())
  motoboyId  String
  diaSemana  DiaSemana
  horaInicio String // Formato HH:MM
  horaFim    String // Formato HH:MM
  ativo      Boolean   @default(true)

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)

  @@unique([motoboyId, diaSemana])
  @@map("disponibilidades")
}

model Cliente {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  cpfCnpj        String?
  tipoPessoa     String   @default("PF") // PF ou PJ
  razaoSocial    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enderecos  Endereco[]
  pedidos    Pedido[]
  pagamentos Pagamento[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, userId])
  @@unique([organizationId, cpfCnpj])
  @@index([userId])
  @@index([organizationId, createdAt, id])
  @@map("clientes")
}

model Endereco {
  id             String   @id @default(cuid())
  organizationId String
  clienteId      String
  apelido        String? // Casa, Trabalho, etc
  cep            String
  logradouro     String
  numero         String
  complemento    String?
  bairro         String
  cidade         String
  estado         String
  latitude       Float?
  longitude      Float?
  favorito       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cliente        Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pedidosOrigem  Pedido[] @relation("EnderecoOrigem")
  pedidosDestino Pedido[] @relation("EnderecoDestino")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, clienteId])
  @@map("enderecos")
}

model Pedido {
  id                String       @id @default(cuid())
  organizationId    String
  clienteId         String
  motoboyId         String?
  enderecoOrigemId  String
  enderecoDestinoId String
  tipoServico       TipoServico
  status            StatusPedido @default(SOLICITADO)

  // Detalhes da entrega
  descricaoItem  String?
  observacoes    String? @db.Text
  pesoAproximado Float? // em kg

  // Valores calculados
  distanciaKm     Float
  duracaoEstimada Int // em minutos
  valorBase       Decimal @db.Decimal(14, 2)
  multiplicador   Float
  valorTotal      Decimal @db.Decimal(14, 2)

  // Agendamento (para entregas agendadas)
  dataAgendada DateTime?

  // Timestamps de status
  aceitoEm           DateTime?
  coletadoEm         DateTime?
  entregueEm         DateTime?
  canceladoEm        DateTime?
  motivoCancelamento String?

  // Confirmação (para documentos)
  assinaturaRecebedor String?
  fotoComprovante     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente         Cliente            @relation(fields: [clienteId], references: [id])
  motoboy         Motoboy?           @relation(fields: [motoboyId], references: [id])
  enderecoOrigem  Endereco           @relation("EnderecoOrigem", fields: [enderecoOrigemId], references: [id])
  enderecoDestino Endereco           @relation("EnderecoDestino", fields: [enderecoDestinoId], references: [id])
  avaliacao       Avaliacao?
  mensagens       Mensagem[]
  pagamento       Pagamento?
  transacoes      TransacaoMotoboy[]

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status, createdAt, id])
  @@index([organizationId, clienteId, createdAt, id])
  @@index([organizationId, motoboyId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@index([clienteId, createdAt, id])
  @@index([motoboyId, status, createdAt, id])
  @@map("pedidos")
}

model Avaliacao {
  id             String   @id @default(cuid())
  organizationId String
  pedidoId       String   @unique
  motoboyId      String
  nota           Int // 1 a 5
  comentario     String?  @db.Text
  createdAt      DateTime @default(now())

  pedido  Pedido  @relation(fields: [pedidoId], references: [id])
  motoboy Motoboy @relation(fields: [motoboyId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, motoboyId, createdAt])
  @@map("avaliacoes")
}

model Mensagem {
  id             String   @id @default(cuid())
  organizationId String
  pedidoId       String
  remetente      String // 'CLIENTE' ou 'MOTOBOY'
  conteudo       String   @db.Text
  lida           Boolean  @default(false)
  createdAt      DateTime @default(now())

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, pedidoId])
  @@index([pedidoId])
  @@map("mensagens")
}

model Pagamento {
  id             String @id @default(cuid())
  organizationId String
  pedidoId       String @unique
  clienteId      String

  // Valores
  valor          Decimal @db.Decimal(14, 2)
  taxaPlataforma Decimal @default(0) @db.Decimal(14, 2) // Taxa cobrada pela plataforma
  valorMotoboy   Decimal @default(0) @db.Decimal(14, 2) // Valor que vai para o motoboy

  // Método e status
  metodo MetodoPagamento
  status StatusPagamento @default(PENDENTE)

  // Dados do pagamento (gateway)
  gatewayId       String? // ID da transação no gateway
  gatewayResponse String? @db.Text // Resposta JSON do gateway

  // PIX
  pixQrCode    String?   @db.Text // QR Code em base64
  pixCopiaCola String?   @db.Text // Código copia e cola
  pixExpiraEm  DateTime?

  // Cartão (dados mascarados)
  cartaoUltimos4 String?
  cartaoBandeira String?

  // Timestamps
  aprovadoEm    DateTime?
  canceladoEm   DateTime?
  reembolsadoEm DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pedido  Pedido  @relation(fields: [pedidoId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, clienteId])
  @@index([clienteId])
  @@index([status])
  @@map("pagamentos")
}

model SaldoMotoboy {
  id              String   @id @default(cuid())
  organizationId  String
  motoboyId       String   @unique
  saldoDisponivel Decimal  @default(0) @db.Decimal(14, 2)
  saldoPendente   Decimal  @default(0) @db.Decimal(14, 2) // Aguardando liberação
  totalRecebido   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt       DateTime @updatedAt

  motoboy Motoboy @relation(fields: [motoboyId], references: [id], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("saldos_motoboy")
}

model TransacaoMotoboy {
  id             String   @id @default(cuid())
  organizationId String
  motoboyId      String
  pedidoId       String?
  tipo           String // 'CREDITO' ou 'SAQUE'
  valor          Decimal  @db.Decimal(14, 2)
  descricao      String
  status         String   @default("PENDENTE") // PENDENTE, CONCLUIDO, CANCELADO
  createdAt      DateTime @default(now())

  motoboy Motoboy @relation(fields: [motoboyId], references: [id])
  pedido  Pedido? @relation(fields: [pedidoId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, motoboyId, createdAt, id])
  @@index([motoboyId])
  @@index([pedidoId])
  @@index([motoboyId, createdAt, id])
  @@map("transacoes_motoboy")
}

// Resposta guardada por (usuário, escopo, chave) para que a repetição de um
// POST com o mesmo Idempotency-Key não duplique pedido ou pagamento.
model IdempotencyKey {
  id          String   @id @default(cuid())
  userId      String
  escopo      String   @db.VarChar(100)
  chave       String   @db.VarChar(255)
  requestHash String   @db.VarChar(64)
  statusCode  Int? // null enquanto a requisição original está em processamento
  resposta    String?  @db.LongText
  createdAt   DateTime @default(now())

  @@unique([userId, escopo, chave])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// Trilha de ações sensíveis (login, status, pagamento, aprovação, comprovante).
// Somente inserção: nenhuma rota altera ou apaga registros.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  acao           String   @db.VarChar(100)
  entidade       String   @db.VarChar(50)
  entidadeId     String?
  dados          Json?
  ip             String?  @db.VarChar(64)
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entidade, entidadeId, createdAt])
  @@index([userId, createdAt])
  @@index([acao, createdAt])
  @@map("audit_logs")
}
